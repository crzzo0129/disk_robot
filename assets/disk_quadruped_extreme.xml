<mujoco model="disk_quadruped_extreme">
  <compiler angle="radian"/>

  <option timestep="0.002" integrator="RK4" cone="elliptic">
    <flag contact="enable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".2 .4 .6" rgb2=".4 .6 .8"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance="0"/>
  </asset>

  <default>
    <joint damping="0.06" armature="0.002" limited="true"/>
    <geom friction="1.0 0.02 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <default class="disk">
      <geom type="cylinder" size="0.24 0.045" rgba="0.1 0.45 0.85 1"
            density="450" condim="4" friction="1.2 0.04 0.002"/>
    </default>
    <default class="leg">
      <geom type="capsule" size="0.018" rgba="0.55 0.55 0.55 1"
            density="350" contype="0" conaffinity="0"/>
    </default>
    <default class="foot">
      <geom type="sphere" size="0.035" rgba="0.15 0.15 0.15 1"
            density="500" condim="4" friction="1.4 0.04 0.002"/>
    </default>
  </default>

  <actuator>
    <position name="fl_hip_abd_act" joint="fl_hip_abd" kp="55" kv="1.2" ctrlrange="-0.9 0.9"/>
    <position name="fl_hip_flex_act" joint="fl_hip_flex" kp="70" kv="1.4" ctrlrange="-3.1 3.1"/>
    <position name="fl_knee_act" joint="fl_knee" kp="55" kv="1.0" ctrlrange="-2.4 2.4"/>
    <position name="fr_hip_abd_act" joint="fr_hip_abd" kp="55" kv="1.2" ctrlrange="-0.9 0.9"/>
    <position name="fr_hip_flex_act" joint="fr_hip_flex" kp="70" kv="1.4" ctrlrange="-3.1 3.1"/>
    <position name="fr_knee_act" joint="fr_knee" kp="55" kv="1.0" ctrlrange="-2.4 2.4"/>
    <position name="hl_hip_abd_act" joint="hl_hip_abd" kp="55" kv="1.2" ctrlrange="-0.9 0.9"/>
    <position name="hl_hip_flex_act" joint="hl_hip_flex" kp="70" kv="1.4" ctrlrange="-3.1 3.1"/>
    <position name="hl_knee_act" joint="hl_knee" kp="55" kv="1.0" ctrlrange="-2.4 2.4"/>
    <position name="hr_hip_abd_act" joint="hr_hip_abd" kp="55" kv="1.2" ctrlrange="-0.9 0.9"/>
    <position name="hr_hip_flex_act" joint="hr_hip_flex" kp="70" kv="1.4" ctrlrange="-3.1 3.1"/>
    <position name="hr_knee_act" joint="hr_knee" kp="55" kv="1.0" ctrlrange="-2.4 2.4"/>
  </actuator>

  <keyframe>
    <key name="stand"
         qpos="0 0 0.32 1 0 0 0
               0 -0.45 0.85
               0 -0.45 0.85
               0 0.45 -0.85
               0 0.45 -0.85"
         ctrl="0 -0.45 0.85
               0 -0.45 0.85
               0 0.45 -0.85
               0 0.45 -0.85"/>
    <key name="folded"
         qpos="0 0 0.24 1 0 0 0
               0.0 -2.60 2.4
               0.0 -2.60 2.4
               0.0 2.60 -2.4
               0.0 2.60 -2.4"
         ctrl="0.0 -2.60 2.4
               0.0 -2.60 2.4
               0.0 2.60 -2.4
               0.0 2.60 -2.4"/>
  </keyframe>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="disk_torso"
           diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3" pos="0 -4 4" cutoff="100"/>
    <geom name="floor" type="plane" size="0 0 .05" material="grid"
          friction="1.2 0.03 0.001" condim="3" contype="1" conaffinity="1"/>
    <camera name="side_cam" mode="targetbody" target="disk_torso" pos="0 -1.6 0.35"/>

    <body name="disk_torso" pos="0 0 0.32">
      <freejoint name="root"/>
      <geom name="torso_disk" class="disk" type="cylinder" size="0.24 0.045" quat="0.7071068 0.7071068 0 0"/>

      <body name="fl_hip_anchor" pos="0.08 0.075 -0.10">
        <geom type="sphere" size="0.005" rgba="0 0 0 0" mass="0.001" contype="0" conaffinity="0"/>
        <joint name="fl_hip_abd" type="hinge" axis="1 0 0" range="-0.9 0.9"/>
        <body name="fl_upper" pos="0 0 0">
          <joint name="fl_hip_flex" type="hinge" axis="0 1 0" range="-3.1 3.1"/>
          <geom class="leg" fromto="0 0 0 0 0 -0.16"/>
          <body name="fl_lower" pos="0 0 -0.16">
            <joint name="fl_knee" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
            <geom class="leg" fromto="0 0 0 0 0 -0.14"/>
            <geom name="fl_foot" class="foot" pos="0 0 -0.14"/>
          </body>
        </body>
      </body>

      <body name="fr_hip_anchor" pos="0.08 -0.075 -0.10">
        <geom type="sphere" size="0.005" rgba="0 0 0 0" mass="0.001" contype="0" conaffinity="0"/>
        <joint name="fr_hip_abd" type="hinge" axis="1 0 0" range="-0.9 0.9"/>
        <body name="fr_upper" pos="0 0 0">
          <joint name="fr_hip_flex" type="hinge" axis="0 1 0" range="-3.1 3.1"/>
          <geom class="leg" fromto="0 0 0 0 0 -0.16"/>
          <body name="fr_lower" pos="0 0 -0.16">
            <joint name="fr_knee" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
            <geom class="leg" fromto="0 0 0 0 0 -0.14"/>
            <geom name="fr_foot" class="foot" pos="0 0 -0.14"/>
          </body>
        </body>
      </body>

      <body name="hl_hip_anchor" pos="-0.08 0.075 -0.10">
        <geom type="sphere" size="0.005" rgba="0 0 0 0" mass="0.001" contype="0" conaffinity="0"/>
        <joint name="hl_hip_abd" type="hinge" axis="1 0 0" range="-0.9 0.9"/>
        <body name="hl_upper" pos="0 0 0">
          <joint name="hl_hip_flex" type="hinge" axis="0 1 0" range="-3.1 3.1"/>
          <geom class="leg" fromto="0 0 0 0 0 -0.16"/>
          <body name="hl_lower" pos="0 0 -0.16">
            <joint name="hl_knee" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
            <geom class="leg" fromto="0 0 0 0 0 -0.14"/>
            <geom name="hl_foot" class="foot" pos="0 0 -0.14"/>
          </body>
        </body>
      </body>

      <body name="hr_hip_anchor" pos="-0.08 -0.075 -0.10">
        <geom type="sphere" size="0.005" rgba="0 0 0 0" mass="0.001" contype="0" conaffinity="0"/>
        <joint name="hr_hip_abd" type="hinge" axis="1 0 0" range="-0.9 0.9"/>
        <body name="hr_upper" pos="0 0 0">
          <joint name="hr_hip_flex" type="hinge" axis="0 1 0" range="-3.1 3.1"/>
          <geom class="leg" fromto="0 0 0 0 0 -0.16"/>
          <body name="hr_lower" pos="0 0 -0.16">
            <joint name="hr_knee" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
            <geom class="leg" fromto="0 0 0 0 0 -0.14"/>
            <geom name="hr_foot" class="foot" pos="0 0 -0.14"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
